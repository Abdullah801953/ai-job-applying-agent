{
  "name": "job-apply-ai-agent",
  "version": "1.0.0",
  "description": "AI-powered LinkedIn Easy Apply automation agent with a React dashboard.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "test": "node dist/scripts/test-ai.js",
    "test:apply": "node dist/scripts/test-apply.js",
    "agent": "node dist/agent.js",
    "server": "node dist/server.js",
    "ui": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "dev": "concurrently \"npm run server\" \"npm run ui\"",
    "start": "node dist/server.js",
    "save-session": "node dist/scripts/save-session.js",
    "lint": "eslint src/**/*.ts scripts/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "linkedin",
    "job-applications",
    "automation",
    "playwright",
    "openai",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.67.3",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.48.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/pdf-parse": "^1.1.4",
    "concurrently": "^8.2.2",
    "typescript": "^5.6.3"
  }
}